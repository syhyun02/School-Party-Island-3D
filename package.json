{
  "name": "school-party-island",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "test:e2e": "playwright test",
    "admin:setup": "node scripts/admin-setup.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.183.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
